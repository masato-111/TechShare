.form
  = simple_form_for @post do |f|
    = f.input :title, placeholder: 'タイトルを入力してください', input_html: { class: "form-control form-control-lg",  "aria-label": ".form-control-lg example"}
    = f.input :body
    = f.button :submit, class: "btn btn-success w-100 mt-3"

