.container.mt-4
  .d-flex.justify-content-between.align-items-center.mb-4
    %h1 ホーム
    = link_to '新規投稿', new_post_path, class: 'btn btn-success'

  - if @posts.present?
    .row.row-cols-1.g-3
      - @posts.each do |post|
        .col
          .card.h-100.shadow-sm
            .card-header.d-flex.justify-content-between
              %span Username
              %span= post.created_at.strftime("%Y/%m/%d %H:%M")
            .card-body
              %h5.card-title= post.title
            .card-footer.bg-transparent.border-0.pb-3
              = link_to '読む', post, class: 'btn btn-outline-success btn-sm'
        
  - else
    .text-center.py-5.text-muted
      %p 投稿された記事はまだありません。